<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #0f111a;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="musicmanager.app.views.BandInfo">
    <children>
        <VBox spacing="14.0" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
            <padding><Insets top="20" right="25" bottom="25" left="25" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button text="← Назад к списку" onAction="#handleBack" style="-fx-background-color: #161b2e; -fx-text-fill: white; -fx-border-color: #232a42; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 9 14;" />
                    <Pane HBox.hgrow="ALWAYS" />
                    <Button text="✏ Редактировать группу" onAction="#handleEditBand" style="-fx-background-color: #7928ca; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 9 14;" />
                    <Label fx:id="chartLabel" style="-fx-text-fill: #ffaa00; -fx-font-size: 13px; -fx-font-weight: bold;" />
                </HBox>
                <ScrollPane fitToWidth="true" style="-fx-background: #0f111a; -fx-background-color: #0f111a; -fx-border-color: #0f111a;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="18" style="-fx-background-color: #0f111a;">
                            <children>
                                <VBox spacing="5" style="-fx-background-color: #161b2e; -fx-background-radius: 8; -fx-border-color: #232a42; -fx-border-radius: 8; -fx-padding: 20;">
                                    <Label fx:id="nameLabel" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" wrapText="true" />
                                    <Label fx:id="summaryLabel" style="-fx-text-fill: #8a99ad; -fx-font-size: 13px;" />
                                </VBox>
                                <VBox spacing="10">
                                    <Label fx:id="membersHeader" text="Музыканты" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
                                    <VBox fx:id="musiciansContainer" spacing="8" />
                                </VBox>
                                <VBox spacing="10">
                                    <Label fx:id="toursHeader" text="Туры" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
                                    <VBox fx:id="toursContainer" spacing="8" />
                                </VBox>
                                <VBox spacing="10">
                                    <Label fx:id="tracksHeader" text="Треки" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
                                    <VBox fx:id="tracksContainer" spacing="8" />
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
