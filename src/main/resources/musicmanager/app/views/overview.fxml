<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #0f111a;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="musicmanager.app.views.Overview">
   <children>
      <VBox prefHeight="700.0" prefWidth="977.0" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>

            <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="200.0">
               <children>
                  <Label text="Обзор деятельности" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Pane HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #1a1f33; -fx-text-fill: white; -fx-cursor: hand;" text="📥 Экспорт файла" />
               </children>
            </HBox>

            <HBox spacing="15.0">
               <children>
                  <AnchorPane minWidth="200.0" prefHeight="100.0" style="-fx-background-color: #161b2e; -fx-background-radius: 8; -fx-border-color: #232a42; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label layoutX="14.0" layoutY="14.0" text="Активные туры" textFill="#8a99ad" />
                        <Label layoutX="14.0" layoutY="40.0" text="1" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                        <Label layoutX="14.0" layoutY="72.0" textFill="#00e5ff" />
                     </children>
                  </AnchorPane>
                  <AnchorPane minWidth="200.0" prefHeight="100.0" style="-fx-background-color: #161b2e; -fx-background-radius: 8; -fx-border-color: #232a42; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label layoutX="14.0" layoutY="14.0" text="Ближайшие концерты" textFill="#8a99ad" />
                        <Label layoutX="14.0" layoutY="40.0" text="3" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                        <Label layoutX="14.0" layoutY="72.0" textFill="#00e5ff" />
                     </children>
                  </AnchorPane>
                  <AnchorPane minWidth="200.0" prefHeight="100.0" style="-fx-background-color: #161b2e; -fx-background-radius: 8; -fx-border-color: #232a42; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label layoutX="14.0" layoutY="14.0" text="Доход за проведенные туры" textFill="#8a99ad" />
                        <Label layoutX="14.0" layoutY="40.0" text="0₽" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                     </children>
                  </AnchorPane>
               </children>
            </HBox>

            <!-- Секция таймлайна -->
            <VBox spacing="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="40.0">
                     <children>
                        <Label text="Календарь событий и гастрольный таймлайн" textFill="#e2e8f0">
                           <font>
                              <Font name="System Bold" size="15.0" />
                           </font>
                        </Label>
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #00e5ff; -fx-cursor: hand;" text="Смотреть все туры →" />
                     </children>
                  </HBox>

                  <!-- Карточки туров, занимающие всю ширину -->
                  <HBox spacing="15.0">
                     <children>
                        <fx:include source="tour_card_menu.fxml" HBox.hgrow="ALWAYS" />
                        <fx:include source="tour_card_menu.fxml" HBox.hgrow="ALWAYS" />
                        <fx:include source="tour_card_menu.fxml" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </VBox>

         </children>
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
