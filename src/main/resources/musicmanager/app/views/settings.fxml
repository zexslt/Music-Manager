<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #0f111a;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="musicmanager.app.views.Settings">
    <children>
        <VBox spacing="16" AnchorPane.bottomAnchor="28" AnchorPane.leftAnchor="28" AnchorPane.rightAnchor="28" AnchorPane.topAnchor="28">
            <children>
                <Label style="-fx-text-fill: #00e5ff; -fx-font-size: 22px; -fx-font-weight: bold;" text="Импорт и экспорт данных" />
                <Label style="-fx-text-fill: #d1d5db; -fx-font-size: 14px;" text="Создайте XML-резервную копию всех групп, музыкантов, треков, туров, городов и связей между ними." wrapText="true" />
                <HBox spacing="12">
                    <Button onAction="#handleExportXml" style="-fx-background-color: #7928ca; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 16;" text="Экспортировать в XML" />
                    <Button onAction="#handleImportXml" style="-fx-background-color: #252a3a; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 16;" text="Импортировать из XML" />
                </HBox>
                <Label fx:id="statusLabel" style="-fx-text-fill: #00e5ff; -fx-font-size: 12px;" wrapText="true" />
                <VBox spacing="6" style="-fx-background-color: #161b2e; -fx-background-radius: 8; -fx-border-color: #232a42; -fx-border-radius: 8; -fx-padding: 16;">
                    <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
                    <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Как работает импорт" />
                    <Label style="-fx-text-fill: #8a99ad;" text="Файл проверяется до записи. Записи с совпадающими ID обновляются, новые добавляются. Данные базы, которых нет в файле, не удаляются. " wrapText="true" />
                </VBox>
            </children>
            <padding><Insets bottom="4" left="4" right="4" top="4" /></padding>
        </VBox>
    </children>
</AnchorPane>
