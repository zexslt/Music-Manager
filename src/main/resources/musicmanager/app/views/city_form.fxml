<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="560.0" prefWidth="560.0" style="-fx-background-color: #0f111a;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="musicmanager.app.views.CityForm">
    <children>
        <VBox spacing="14" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
            <padding><Insets top="22" right="24" bottom="24" left="24" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Города" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
                    <Pane HBox.hgrow="ALWAYS" />
                    <Button text="Закрыть" onAction="#handleClose" style="-fx-background-color: #252a3a; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 12;" />
                </HBox>
                <Label text="Добавьте город в справочник. Если такое название уже есть, существующая запись будет использована повторно." wrapText="true" style="-fx-text-fill: #8a99ad;" />
                <HBox spacing="10">
                    <TextField fx:id="cityNameField" promptText="Название города (до 45 символов)" HBox.hgrow="ALWAYS" />
                    <Button text="Добавить" onAction="#handleAddCity" style="-fx-background-color: #7928ca; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 14;" />
                </HBox>
                <Label fx:id="statusLabel" wrapText="true" style="-fx-text-fill: #00e5ff;" />
                <Label text="Города в базе" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" />
                <ListView fx:id="citiesList" VBox.vgrow="ALWAYS" style="-fx-background-color: #161b2e; -fx-control-inner-background: #161b2e; -fx-text-fill: white;" />
            </children>
        </VBox>
    </children>
</AnchorPane>
